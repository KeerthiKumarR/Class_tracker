GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=qwen/qwen3.8-27b
WHISPER_GROQ_MODEL=whisper-large-v3


SARVAM_API_KEY=your-sarvam-key-optional
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json
# Optional for cloud deployments: raw JSON string of service account key
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account",...}
WHISPER_LANGUAGE=hi
WATCH_FOLDER=~/ClassAudio/incoming
CURRICULUM_PATH=config/curriculum.json
SHEET_TAB_NAME=DAA
DELETE_AUDIO_AFTER_PROCESS=false

# Email Notifications (Gmail SMTP with App Password)
GMAIL_SENDER=daa.classbot@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
TEACHER_EMAIL=teacher@email.com
DEVELOPER_EMAIL=you@email.com

# Deployment URL
RENDER_URL=https://your-app.onrender.com

